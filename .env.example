# 相对路径以项目根目录为准
BTIR_OUTPUT_DIR=output
BTIR_MODELS_DIR=models

# 可选的单项路径覆盖；更换模型或前端目录时按需取消注释
# BTIR_FRONTEND_DIR=frontend
# BTIR_3D_SEGMENTER_SCRIPT=models/segmentation3d/inference.py
# BTIR_3D_SEGMENTER_MODEL=models/segmentation3d/model/model_epoch_297.pth

# 推理设备：
# auto：检测到已正确安装的 CUDA 或 ROCm PyTorch 时使用 GPU，否则使用 CPU
# cpu：始终使用 CPU
# cuda 或 cuda:0：强制使用 GPU；ROCm 在 PyTorch 中也借用 cuda 名
BTIR_DEVICE=auto

# 四模态 3D NIfTI 上传总大小、单个体积最大体素数与滑窗重叠率
BTIR_MAX_3D_UPLOAD_BYTES=536870912
BTIR_MAX_3D_VOXELS=20000000
BTIR_3D_SEGMENTER_OVERLAP=0.5

# GPU 可用于 3D 分割结果累积的最低空闲显存，显存较小时可降低
BTIR_3D_CUDA_ACCUMULATOR_RESERVE_MB=3072

# 快速模式启用 cuDNN benchmark 与 TF32；需逐批评测时设为 false
BTIR_3D_FAST_INFERENCE=true

# 3D 任务固定使用本地二分类 ViT；异常由任务队列重试一次，仍失败则任务失败
# 从配置模态提取轴向切片，按全部切片平均概率生成病例级结果
BTIR_VIT_CLASSIFIER_MODEL_DIR=models/classification/vit-binary
BTIR_VIT_CLASSIFIER_MAX_SLICES=25
BTIR_VIT_CLASSIFIER_BATCH_SIZE=25
BTIR_VIT_CLASSIFIER_THRESHOLD=0.548381

# ViT 默认使用 FLAIR；分类成功后继续执行 3D 分割
BTIR_3D_CLASSIFIER_MODALITY=flair

# AI 分析模型，默认开启，启用时设为 true 并配置 BTIR_AI_API_KEY
BTIR_AI_ANALYSIS_ENABLED=true
BTIR_AI_API_KEY=
BTIR_AI_BASE_URL=https://api.deepseek.com
BTIR_AI_MODEL=deepseek-v4-flash
BTIR_AI_TIMEOUT_SECONDS=20
BTIR_AI_MAX_RETRIES=1
BTIR_AI_MAX_TOKENS=700
BTIR_AI_TEMPERATURE=0.2

# 允许访问 API 的前端地址
BTIR_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Redis 任务结果写回锁
BTIR_REDIS_URL=redis://127.0.0.1:6379/0
BTIR_REDIS_SOCKET_TIMEOUT_SECONDS=3

# SQLite 锁等待、上传文件复制块大小与 ZIP、DICOM 文件数量上限
BTIR_SQLITE_BUSY_TIMEOUT_SECONDS=5
BTIR_UPLOAD_COPY_CHUNK_BYTES=1048576
BTIR_MAX_VOLUME_ARCHIVE_MEMBERS=128
BTIR_MAX_DICOM_FILES=2000

# 单次 JSON 结果写回最长持锁时间；此锁不包含模型推理过程
BTIR_TASK_LOCK_TIMEOUT_SECONDS=30

# 锁被占用时最多等待秒数；超时后接口返回 409
BTIR_TASK_LOCK_WAIT_SECONDS=5

# 滑窗分割期间刷新取消状态的最小间隔秒数，减少 Redis 和 SQLite 访问
BTIR_TASK_CANCEL_CHECK_INTERVAL_SECONDS=0.5

# RQ 3D 异步推理队列
BTIR_TASK_QUEUE_NAME=inference-3d
BTIR_TASK_JOB_TIMEOUT_SECONDS=3600
BTIR_TASK_JOB_RESULT_TTL_SECONDS=86400

# 首次失败后自动再试次数；设为 0 可禁用自动重试
BTIR_TASK_JOB_MAX_RETRIES=1
# running 状态超过此时长仍未结束，将在查询时标记为 failed
BTIR_TASK_STALE_AFTER_SECONDS=3660

# 每次后台巡检最多处理的活动任务数
BTIR_TASK_RECONCILE_BATCH_SIZE=100

# Windows SimpleWorker 启动时预加载模型，把首次任务的冷启动延后到 worker 启动阶段
BTIR_WORKER_PRELOAD_MODELS=true

# Linux 默认使用 simple，预加载模型
# 若避免 fork 后 CUDA 初始化风险，可设为 standard
BTIR_LINUX_WORKER_MODE=simple

# 允许批量归档与永久删除命令落地；仍必须显式传入 --apply，不会自动定时执行
BTIR_TASK_CLEANUP_ENABLED=true
BTIR_SUCCEEDED_TASK_RETENTION_DAYS=30
BTIR_CANCELED_TASK_RETENTION_DAYS=7
BTIR_TASK_ARCHIVE_GRACE_DAYS=7
BTIR_TASK_ARCHIVE_DIR=archive

# 审计日志按大小轮转，保留指定天数和最多指定数量的历史分片
BTIR_AUDIT_LOG_MAX_BYTES=10485760
BTIR_AUDIT_LOG_RETENTION_DAYS=90
BTIR_AUDIT_LOG_MAX_ROTATED_FILES=30

# 数据库文件路径
BTIR_TASK_DATABASE_PATH=data/btir.db

# JWT 认证配置
# 密钥用于签名 JWT Token，必须设置为至少 32 字节的随机字符串
BTIR_JWT_SECRET_KEY=
# Token 过期时间（小时）
BTIR_JWT_EXPIRATION_HOURS=24
# Token 签名算法
BTIR_JWT_ALGORITHM=HS256
# 是否允许公开注册；创建初始账号后建议关闭
BTIR_REGISTRATION_ENABLED=false
# 登录限流：同一账号、同一来源 IP 在窗口内允许的请求次数
BTIR_AUTH_LOGIN_USER_ATTEMPTS=10
BTIR_AUTH_LOGIN_IP_ATTEMPTS=60
BTIR_AUTH_LOGIN_WINDOW_SECONDS=300
# 注册限流：同一来源 IP 在窗口内允许的请求次数
BTIR_AUTH_REGISTRATION_IP_ATTEMPTS=5
BTIR_AUTH_REGISTRATION_WINDOW_SECONDS=3600
# 单个用户最多保留的任务数，以及最多同时排队/运行的任务数
BTIR_MAX_TASKS_PER_USER=1000
BTIR_MAX_ACTIVE_TASKS_PER_USER=2
