# 相对路径以项目根目录为准
BTIR_OUTPUT_DIR=output
BTIR_MODELS_DIR=models

# 推理设备：
# auto：检测到已正确安装的 CUDA 或 ROCm PyTorch 时使用 GPU，否则使用 CPU
# cpu：始终使用 CPU
# cuda 或 cuda:0：强制使用 GPU；ROCm 在 PyTorch 中也借用 cuda 名
BTIR_DEVICE=auto

# 默认分割阈值，范围为 0 到 1
BTIR_DEFAULT_SEGMENT_THRESHOLD=0.5

# 允许访问 API 的前端地址
BTIR_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Redis 任务结果写回锁
BTIR_REDIS_URL=redis://127.0.0.1:6379/0

# 单次 JSON 结果写回最长持锁时间；此锁不包含模型推理过程
BTIR_TASK_LOCK_TIMEOUT_SECONDS=30

# 锁被占用时最多等待秒数；超时后接口返回 409
BTIR_TASK_LOCK_WAIT_SECONDS=5

# RQ 异步推理队列
BTIR_TASK_QUEUE_NAME=inference
BTIR_TASK_JOB_TIMEOUT_SECONDS=3600
BTIR_TASK_JOB_RESULT_TTL_SECONDS=86400

# 数据库文件路径
BTIR_TASK_DATABASE_PATH=data/btir.db
